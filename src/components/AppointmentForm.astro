---
import { locations } from '../data/locations';
import { getLangFromUrl } from '../i18n/utils';

export interface Props {
  locationSlug?: string;
}

const { locationSlug } = Astro.props;
const es = getLangFromUrl(Astro.url) === 'es';
---

<form id="appointmentForm" class="space-y-6">
  <div>
    <label for="name" class="block text-sm font-medium text-gray-700 mb-1">{es ? 'Nombre' : 'Name'}</label>
    <input
      type="text"
      id="name"
      name="name"
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-transparent outline-none transition-shadow"
      required
    >
  </div>

  <div class="grid md:grid-cols-2 gap-6">
    <div>
      <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">{es ? 'Teléfono' : 'Phone'}</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-transparent outline-none transition-shadow"
        required
      >
    </div>
    <div>
      <label for="email" class="block text-sm font-medium text-gray-700 mb-1">{es ? 'Correo Electrónico' : 'Email'}</label>
      <input
        type="email"
        id="email"
        name="email"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-transparent outline-none transition-shadow"
        required
      >
    </div>
  </div>

  <div>
    <label for="office" class="block text-sm font-medium text-gray-700 mb-1">{es ? 'Oficina Preferida' : 'Preferred Office'}</label>
    <select
      id="office"
      name="office"
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-transparent outline-none transition-shadow bg-white"
      required
    >
      <option value="">{es ? 'Seleccione una oficina...' : 'Select an Office...'}</option>
      {locations.map((loc) => (
        <option value={loc.slug} selected={locationSlug === loc.slug}>{loc.name}</option>
      ))}
    </select>
  </div>

  <div>
    <label for="date" class="block text-sm font-medium text-gray-700 mb-1">{es ? 'Fecha Preferida' : 'Preferred Date'}</label>
    <input
      type="date"
      id="date"
      name="date"
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-transparent outline-none transition-shadow"
    >
  </div>

  <div>
    <label for="message" class="block text-sm font-medium text-gray-700 mb-1">{es ? 'Mensaje' : 'Message'}</label>
    <textarea
      id="message"
      name="message"
      rows="3"
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-transparent outline-none transition-shadow"
      placeholder={es ? 'Cuéntenos cómo podemos ayudarle...' : 'Tell us how we can help...'}
    ></textarea>
  </div>

  <p class="text-sm text-gray-600 bg-brand-blue/5 border border-brand-blue/20 rounded-lg px-4 py-3">
    💡 <strong>{es ? 'Financiamiento 0% Disponible' : '0% Financing Available'}</strong> — {es ? 'Pregunte por planes de pago flexibles que se ajusten a su presupuesto.' : 'Ask us about flexible payment plans to fit your budget.'}
  </p>

  <button
    type="submit"
    id="submitBtn"
    class="w-full bg-brand-gold text-white font-bold py-4 rounded-xl hover:bg-brand-gold/90 transition-colors shadow-lg text-lg disabled:opacity-50 disabled:cursor-not-allowed"
  >
    {es ? 'Solicitar Cita' : 'Request Appointment'}
  </button>
  <p class="text-xs text-center text-gray-500 mt-4">
    {es ? '*Este es un formulario de solicitud. Nuestro equipo le contactará para confirmar su cita.' : '*This is a request form. Our team will contact you to confirm your actual appointment time.'}
  </p>
</form>

<script is:inline define:vars={{
  msgSending: es ? 'Enviando...' : 'Sending...',
  msgSuccessTitle: es ? '¡Solicitud Enviada!' : 'Request Sent!',
  msgSuccessText: es ? 'Gracias por su solicitud. Nuestro equipo le contactará pronto para confirmar su cita.' : 'Thank you for your request. Our team will contact you shortly to confirm your appointment.',
  msgErrorTitle: 'Error',
  msgErrorText: es ? 'Hubo un problema al enviar su solicitud. Inténtelo de nuevo más tarde o llámenos.' : 'There was a problem sending your request. Please try again later or call us.',
  msgSubmit: es ? 'Solicitar Cita' : 'Request Appointment',
}}>
  const appointmentForm = document.getElementById('appointmentForm');
  const submitBtn = document.getElementById('submitBtn');
  const WEBHOOK_URL = 'https://ain8n.innovexitsolutions.com/webhook/liberty-smile-center-contact';

  const loadSwal = () => new Promise((resolve) => {
    if (window.Swal) return resolve(window.Swal);
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/sweetalert2@11';
    script.onload = () => resolve(window.Swal);
    document.head.appendChild(script);
  });

  appointmentForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const Swal = await loadSwal();

    submitBtn.disabled = true;
    submitBtn.textContent = msgSending;

    try {
      const formData = new FormData(appointmentForm);
      const data = Object.fromEntries(formData.entries());
      data.formType = 'appointment';
      data.domain = 'libertysmilecenter.com';

      const response = await fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (response.ok) {
        Swal.fire({
          title: msgSuccessTitle,
          text: msgSuccessText,
          icon: 'success',
          confirmButtonColor: '#006BB6',
        });
        appointmentForm.reset();
      } else {
        throw new Error('Submission failed');
      }
    } catch (error) {
      console.error('Error:', error);
      Swal.fire({
        title: msgErrorTitle,
        text: msgErrorText,
        icon: 'error',
        confirmButtonColor: '#006BB6',
      });
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = msgSubmit;
    }
  });
</script>
