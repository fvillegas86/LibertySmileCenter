---
import { getLangFromUrl, useTranslations, getRelativeLocaleUrl } from '../i18n/utils';
import { locations } from '../data/locations';
import type { LocationData } from '../data/locations';

interface Props {
  locationData?: LocationData;
}

const { locationData } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const homeUrl = getRelativeLocaleUrl(lang, '/');

// Build service URLs: location-specific if on a location page, otherwise general
const generalUrl = locationData 
  ? getRelativeLocaleUrl(lang, `${locationData.slug}/general-dentistry`)
  : getRelativeLocaleUrl(lang, 'general-dentistry');
const implantsUrl = locationData
  ? getRelativeLocaleUrl(lang, `${locationData.slug}/dental-implants`)
  : getRelativeLocaleUrl(lang, 'dental-implants');
const contactUrl = getRelativeLocaleUrl(lang, 'contact');
const privacyUrl = getRelativeLocaleUrl(lang, 'privacy-policy');
---

<footer class="bg-slate-900 text-white">
  <div class="pt-16 pb-8">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <!-- About -->
      <div>
        <h3 class="text-xl font-bold mb-4 text-white">{t('footer.about.title')}</h3>
        <p class="text-gray-300 leading-relaxed mb-4">
          {t('footer.about.text')}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xl font-bold mb-4 text-white">{t('footer.quick_links')}</h3>
        <ul class="space-y-3">
            <li><a href={homeUrl} class="text-gray-300 hover:text-brand-gold transition-colors py-2 min-h-[48px] flex items-center">{t('nav.home')}</a></li>
            <li><a href={generalUrl} class="text-gray-300 hover:text-brand-gold transition-colors py-2 min-h-[48px] flex items-center">{t('nav.service.general_dentistry')}</a></li>
            <li><a href={implantsUrl} class="text-gray-300 hover:text-brand-gold transition-colors py-2 min-h-[48px] flex items-center">{t('nav.service.dental_implants')}</a></li>
            <li><a href={contactUrl} class="text-gray-300 hover:text-brand-gold transition-colors py-2 min-h-[48px] flex items-center">{t('nav.contact')}</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-xl font-bold mb-4 text-white">{t('footer.contact_us')}</h3>
        <ul class="space-y-4">
            {locationData ? (
              // Show single location data
              <>
                <li class="flex items-start gap-3">
                    <span class="text-brand-gold mt-1" aria-hidden="true">📍</span>
                    <div>
                        <span class="font-semibold text-white">{locationData.name}</span><br>
                        <span class="text-gray-300 text-sm">{locationData.address}</span>
                        <a href={`https://maps.google.com/?q=${encodeURIComponent(locationData.address)}`} target="_blank" class="text-brand-gold hover:underline text-sm">Get Directions</a>
                    </div>
                </li>
                <li class="flex items-center gap-3">
                    <span class="text-brand-gold" aria-hidden="true">📞</span>
                    <a href={`tel:${locationData.phone}`} class="text-gray-300 hover:text-white whitespace-nowrap">{locationData.phoneDisplay}</a>
                </li>
                <li class="flex items-center gap-3">
                    <span class="text-brand-gold">✉️</span>
                    <a href="mailto:info@libertysmilecenter.com" class="min-w-0 [overflow-wrap:anywhere] text-gray-300 hover:text-white">info@libertysmilecenter.com</a>
                </li>
                <!-- Small Google Map -->
                <li class="mt-4">
                    <div class="bg-gray-200 rounded-lg h-32 overflow-hidden">
                        <iframe
                            src={locationData.mapUrl}
                            width="100%"
                            height="100%"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </li>
              </>
            ) : (
              // Show all locations
              <>
                {locations.map(loc => (
                    <li class="flex items-start gap-3">
                        <span class="text-brand-gold mt-1" aria-hidden="true">📍</span>
                        <div>
                            <a href={getRelativeLocaleUrl(lang, loc.slug)} class="font-semibold text-white hover:text-brand-gold transition-colors">{loc.name}</a><br>
                            <span class="text-gray-300 text-sm">{loc.address}</span>
                            <a href={`tel:${loc.phone}`} class="text-gray-300 hover:text-white block text-sm whitespace-nowrap">{loc.phoneDisplay}</a>
                        </div>
                    </li>
                ))}
                <li class="flex items-center gap-3">
                    <span class="text-brand-gold">✉️</span>
                    <a href="mailto:info@libertysmilecenter.com" class="min-w-0 [overflow-wrap:anywhere] text-gray-300 hover:text-white">info@libertysmilecenter.com</a>
                </li>
              </>
            )}
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-600 pt-8 flex flex-col md:flex-row justify-between items-center text-gray-500 text-sm">
      <p>&copy; {currentYear} Liberty Smile Center. {t('footer.rights')}</p>
      <a href={privacyUrl} class="hover:text-brand-gold transition-colors mt-2 md:mt-0 py-2 min-h-[48px] flex items-center">{t('footer.privacy')}</a>
    </div>
  </div>
  </div>
</footer>
