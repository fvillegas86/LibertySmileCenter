---
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-white pt-16 pb-8">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div>
        <h3 class="text-xl font-bold text-white mb-6">Liberty Smile Center</h3>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          Dedicated to fulfilling your dental needs with excellence. Conveniently located in South Gate and Van Nuys.
        </p>
        <div class="flex gap-4">
          <a href="#" class="text-slate-400 hover:text-brand-gold transition-colors"><Icon name="mdi:facebook" class="size-6" /></a>
          <a href="#" class="text-slate-400 hover:text-brand-gold transition-colors"><Icon name="mdi:instagram" class="size-6" /></a>
          <a href="#" class="text-slate-400 hover:text-brand-gold transition-colors"><Icon name="mdi:twitter" class="size-6" /></a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-lg font-bold text-brand-gold mb-6">Quick Links</h4>
        <ul class="space-y-3 text-sm text-slate-300">
          <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/#services" class="hover:text-white transition-colors">Our Services</a></li>
          <li><a href="/testimonials" class="hover:text-white transition-colors">Patient Reviews</a></li>
          <li><a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- South Gate -->
      <div>
        <h4 class="text-lg font-bold text-brand-gold mb-6">South Gate</h4>
        <ul class="space-y-3 text-sm text-slate-300">
          <li class="flex items-start gap-3">
             <Icon name="mdi:map-marker" class="size-5 text-brand-blue shrink-0 mt-0.5" />
             <span>8330 Long Beach Blvd #107<br/>South Gate, CA 90280</span>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="mdi:phone" class="size-5 text-brand-blue shrink-0" />
            <a href="tel:3235649400" class="hover:text-white">(323) 564-9400</a>
          </li>
        </ul>
      </div>

      <!-- Van Nuys -->
      <div>
        <h4 class="text-lg font-bold text-brand-gold mb-6">Van Nuys</h4>
        <ul class="space-y-3 text-sm text-slate-300">
          <li class="flex items-start gap-3">
             <Icon name="mdi:map-marker" class="size-5 text-brand-blue shrink-0 mt-0.5" />
             <span>6736 Sepulveda Blvd<br/>Van Nuys, CA 91411</span>
          </li>
          <li class="flex items-center gap-3">
             <Icon name="mdi:phone" class="size-5 text-brand-blue shrink-0" />
             <a href="tel:8187868803" class="hover:text-white">(818) 786-8803</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-800 pt-8 text-center text-sm text-slate-500">
      <p>&copy; {year} Liberty Smile Center. All rights reserved.</p>
    </div>
  </div>
</footer>
