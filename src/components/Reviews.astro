const sectionTitle = lang === 'es' ? 'Lo Que Dicen Nuestros Pacientes' : 'What Our Patients Say';
const sectionSubtitle = lang === 'es' ? 'Reseñas reales de pacientes reales' : 'Real reviews from real patients';

const reviews = location ? reviewsByLocation[location]?.[lang] || [] : [];
---

<section class="py-12 md:py-20 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-brand-blue mb-4">{sectionTitle}</h2>
      <p class="text-xl text-gray-600">{sectionSubtitle}</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {reviews.map((review) => (
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 hover:shadow-lg transition-shadow">
          <div class="flex items-center gap-1 mb-4">
            {Array.from({ length: review.stars }).map(() => (
              <span class="text-brand-gold text-xl">★</span>
            ))}
          </div>
          <p class="text-gray-600 mb-6 leading-relaxed">"{review.text}"</p>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-brand-blue/10 rounded-full flex items-center justify-center">
              <span class="text-brand-blue font-bold text-lg">{review.name.charAt(0)}</span>
            </div>
            <span class="font-semibold text-gray-800">{review.name}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
