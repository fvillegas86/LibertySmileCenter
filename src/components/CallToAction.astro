---
import { locations, type LocationData } from '../data/locations';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title?: string;
  text?: string;
  btnAppt?: string;
  btnCallTxt?: string;
  locationData?: LocationData;
  feature1?: string;
  feature2?: string;
  feature3?: string;
}

const lang = getLangFromUrl(Astro.url);

const {
  title = lang === 'es' ? '¿Listo para Transformar Su Sonrisa?' : 'Ready to Transform Your Smile?',
  text = lang === 'es'
    ? 'Programe su consulta hoy y experimente la diferencia de la atención dental personalizada.'
    : 'Schedule your consultation today and experience the difference of personalized dental care.',
  btnAppt = lang === 'es' ? 'Hacer Cita' : 'Book Appointment',
  btnCallTxt = lang === 'es' ? 'Llamar Ahora' : 'Call Now',
  locationData,
  feature1 = lang === 'es' ? 'Citas el Mismo Día' : 'Same-Day Appointments Available',
  feature2 = lang === 'es' ? 'Abierto Sábado' : 'Open Saturday',
  feature3 = lang === 'es' ? 'Financiamiento desde 0% Interés' : 'Easy Finance from 0% Interest'
} = Astro.props;

const displayPhone = locationData ? locationData.phoneDisplay : '';
const cleanPhone = locationData ? locationData.phone : '';
---

<section class="bg-brand-blue text-white py-16">
  <div class="container mx-auto px-4 text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-6">{title}</h2>
    <p class="text-blue-50 text-xl mb-8 max-w-2xl mx-auto">
      {text}
    </p>

    <div class="grid grid-cols-3 gap-4 max-w-3xl mx-auto mb-8">
      <div class="flex flex-col items-center gap-2">
        <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center text-2xl" aria-hidden="true">📅</div>
        <span class="text-sm font-semibold text-white">{feature1}</span>
      </div>
      <div class="flex flex-col items-center gap-2">
        <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center text-2xl" aria-hidden="true">🗓️</div>
        <span class="text-sm font-semibold text-white">{feature2}</span>
      </div>
      <div class="flex flex-col items-center gap-2">
        <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center text-2xl" aria-hidden="true">💳</div>
        <span class="text-sm font-semibold text-white">{feature3}</span>
      </div>
    </div>

    {locationData ? (
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href={`tel:${cleanPhone}`} class="inline-block bg-white text-brand-blue font-bold py-4 px-8 rounded-full hover:bg-blue-50 transition-colors shadow-lg">
          {btnCallTxt} {displayPhone}
        </a>
        <a href={locationData ? `/${locationData.slug}/appointment` : "/appointment"} class="inline-block bg-transparent border-2 border-white text-white font-bold py-4 px-8 rounded-full hover:bg-white/10 transition-colors">
          {btnAppt}
        </a>
      </div>
    ) : (
      <div class="flex flex-col items-center">

        <div class="office-phone-grid mx-auto w-full mb-10">
          {locations.map(loc => (
            <div class="bg-white/10 backdrop-blur-sm p-4 rounded-xl border border-white/20 flex flex-col justify-between items-center hover:bg-white/20 transition-colors">
              <h3 class="font-bold text-xl mb-4">{loc.name}</h3>
              <a href={`tel:${loc.phone}`} class="inline-block whitespace-nowrap bg-white text-brand-blue text-sm font-bold py-3 px-3 rounded-full hover:bg-blue-50 transition-colors shadow-lg w-full text-center">
                📞 {loc.phoneDisplay}
              </a>
            </div>
          ))}
        </div>

        <div class="flex justify-center">
          <a href={locationData ? `/${locationData.slug}/appointment` : "/appointment"} class="inline-block bg-transparent border-2 border-white text-white font-bold py-4 px-12 rounded-full hover:bg-white/10 transition-colors text-lg">
            {btnAppt}
          </a>
        </div>

      </div>
    )}
  </div>
</section>

<style>
  .office-phone-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 16px;
  }
</style>
