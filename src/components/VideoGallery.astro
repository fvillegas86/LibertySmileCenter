---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const VIDEO_BASE = 'https://vd.libertysmilecenter.com/videos';
const portraitVideos = [3, 4, 5, 6, 7].map((n) => ({
  src: `${VIDEO_BASE}/videoplayback${n}.mp4`,
  poster: `/videos/posters/videoplayback${n}.jpg`,
}));
const landscapeVideo = {
  src: `${VIDEO_BASE}/videoplayback1.mp4`,
  poster: '/videos/posters/videoplayback1.jpg',
};
---

<section class="py-16 md:py-24 bg-slate-50">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">{t('videos.title')}</h2>
      <p class="text-xl text-slate-600">{t('videos.subtitle')}</p>
    </div>

    <div class="max-w-3xl mx-auto mb-10">
      <video
        src={landscapeVideo.src}
        poster={landscapeVideo.poster}
        controls
        preload="metadata"
        playsinline
        class="w-full rounded-2xl shadow-lg bg-black aspect-video"
      ></video>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 max-w-6xl mx-auto">
      {portraitVideos.map((video) => (
        <video
          src={video.src}
          poster={video.poster}
          controls
          preload="metadata"
          playsinline
          class="w-full rounded-xl shadow-md bg-black aspect-[9/16] object-cover"
        ></video>
      ))}
    </div>
  </div>
</section>
