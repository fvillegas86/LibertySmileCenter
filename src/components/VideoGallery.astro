---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const portraitVideos = [
  '/videos/videoplayback3.mp4',
  '/videos/videoplayback4.mp4',
  '/videos/videoplayback5.mp4',
  '/videos/videoplayback6.mp4',
  '/videos/videoplayback7.mp4',
];
const landscapeVideo = '/videos/videoplayback1.mp4';
---

<section class="py-16 md:py-24 bg-slate-50">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">{t('videos.title')}</h2>
      <p class="text-xl text-slate-600">{t('videos.subtitle')}</p>
    </div>

    <div class="max-w-3xl mx-auto mb-10">
      <video
        src={landscapeVideo}
        controls
        preload="metadata"
        playsinline
        class="w-full rounded-2xl shadow-lg bg-black aspect-video"
      ></video>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 max-w-6xl mx-auto">
      {portraitVideos.map((src) => (
        <video
          src={src}
          controls
          preload="metadata"
          playsinline
          class="w-full rounded-xl shadow-md bg-black aspect-[9/16] object-cover"
        ></video>
      ))}
    </div>
  </div>
</section>
