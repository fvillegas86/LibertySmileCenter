---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Dentist South Gate CA | Liberty Smile Center" description="Top rated dentist in South Gate, CA. Dental Implants, Braces, and Oral Surgery. Accepts Medi-Cal and PPO. Call (323) 564-9400.">
  <div class="bg-brand-blue py-16 text-white text-center">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold mb-2">Liberty Smile Center - South Gate</h1>
      <p class="text-blue-100">Serving South Gate, Lynwood, Downey, and Huntington Park.</p>
    </div>
  </div>

  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <div>
          <h2 class="text-2xl font-bold mb-4 text-slate-900">Visit Our South Gate Office</h2>
          <div class="space-y-4 text-lg">
             <div class="flex items-start gap-3">
               <Icon name="mdi:map-marker" class="size-6 text-brand-blue shrink-0 mt-1" />
               <p>
                 8330 Long Beach Blvd #107<br/>
                 South Gate, CA 90280
               </p>
             </div>
             <div class="flex items-center gap-3">
               <Icon name="mdi:phone" class="size-6 text-brand-blue shrink-0" />
               <a href="tel:3235649400" class="hover:underline font-semibold">(323) 564-9400</a>
             </div>
          </div>
          <div class="mt-8">
            <h3 class="font-bold mb-2">Services Available Here:</h3>
            <ul class="grid grid-cols-2 gap-2 text-sm text-slate-600">
              <li>• General Dentistry</li>
              <li>• Dental Implants</li>
              <li>• Orthodontics (Braces)</li>
              <li>• Cosmetic Dentistry</li>
              <li>• Oral Surgery</li>
            </ul>
          </div>
        </div>
        <div class="h-80 md:h-auto bg-slate-200 rounded-xl overflow-hidden shadow-md">
           <iframe 
             src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3309.814231644063!2d-118.2127116847849!3d33.96695308062973!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80c2cae14013446b%3A0xb35e7d1420750596!2sLiberty%20Smile%20Center!5e0!3m2!1sen!2sus!4v1645000000000!5m2!1sen!2sus" 
             width="100%" 
             height="100%" 
             style="border:0;" 
             allowfullscreen="" 
             loading="lazy">
           </iframe>
        </div>
      </div>
      <div class="text-center">
        <a href="tel:3235649400" class="inline-flex items-center gap-2 px-8 py-4 bg-brand-gold text-slate-900 font-bold rounded-full shadow-lg hover:bg-yellow-500 transition-colors">
          <Icon name="mdi:calendar-check" class="size-5" />
          Book Appointment in South Gate
        </a>
      </div>
    </div>
  </section>
</Layout>
