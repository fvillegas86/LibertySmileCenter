---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Dentist Van Nuys CA | Liberty Smile Center" description="Expert Dentist in Van Nuys, CA. Offering Implants, Braces, and Cosmetic Dentistry. 0% Interest Financing. Call (818) 786-8803.">
  <div class="bg-brand-blue py-16 text-white text-center">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold mb-2">Liberty Smile Center - Van Nuys</h1>
      <p class="text-blue-100">Serving Van Nuys, Sherman Oaks, North Hollywood, and the San Fernando Valley.</p>
    </div>
  </div>

  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <div>
          <h2 class="text-2xl font-bold mb-4 text-slate-900">Visit Our Van Nuys Office</h2>
          <div class="space-y-4 text-lg">
             <div class="flex items-start gap-3">
               <Icon name="mdi:map-marker" class="size-6 text-brand-blue shrink-0 mt-1" />
               <p>
                 6736 Sepulveda Blvd<br/>
                 Van Nuys, CA 91411
               </p>
             </div>
             <div class="flex items-center gap-3">
               <Icon name="mdi:phone" class="size-6 text-brand-blue shrink-0" />
               <a href="tel:8187868803" class="hover:underline font-semibold">(818) 786-8803</a>
             </div>
          </div>
          <div class="mt-8">
            <h3 class="font-bold mb-2">Services Available Here:</h3>
            <ul class="grid grid-cols-2 gap-2 text-sm text-slate-600">
              <li>• General Dentistry</li>
              <li>• Dental Implants</li>
              <li>• Orthodontics (Braces)</li>
              <li>• Cosmetic Dentistry</li>
              <li>• Oral Surgery</li>
            </ul>
          </div>
        </div>
        <div class="h-80 md:h-auto bg-slate-200 rounded-xl overflow-hidden shadow-md">
           <!-- Placeholder Map Iframe - replacing with generic query if specific ID unknown, but using the address is safe -->
           <iframe 
             src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3299.814231644063!2d-118.465!3d34.195!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNjbCsDIxJzMwLjAiTiAxMTjCsDI3JzUzLjQiVw!5e0!3m2!1sen!2sus!4v1645000000000!5m2!1sen!2sus" 
             title="Van Nuys Location"
             width="100%" 
             height="100%" 
             style="border:0;" 
             allowfullscreen="" 
             loading="lazy">
           </iframe>
        </div>
      </div>
      <div class="text-center">
        <a href="tel:8187868803" class="inline-flex items-center gap-2 px-8 py-4 bg-brand-gold text-slate-900 font-bold rounded-full shadow-lg hover:bg-yellow-500 transition-colors">
          <Icon name="mdi:calendar-check" class="size-5" />
          Book Appointment in Van Nuys
        </a>
      </div>
    </div>
  </section>
</Layout>
