---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallToAction from '../components/CallToAction.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { locations } from '../data/locations';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Liberty Smile Center",
  "description": "Learn about Liberty Smile Center, a family dental practice serving South Gate, Van Nuys, Whittier, La Habra, and Downey, CA.",
  "url": "https://libertysmilecenter.com/about"
};
---

<Layout title="About Liberty Smile Center - Top Rated Dentist in Southern California" description="Liberty Smile Center is a family dental practice serving South Gate, Van Nuys, Whittier, La Habra, and Downey, CA. 10+ years of experience. Accepting Medi-Cal and PPO. 0% interest financing." jsonLd={aboutSchema}>
  <Header />

  <main id="main-content">
    <section class="relative py-24 lg:py-32 flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-black/50 z-10"></div>
        <img
          src="/images/dental/main-office.webp"
          alt="Liberty Smile Center Dental Office"
          width="1600"
          height="900"
          loading="eager"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="container mx-auto px-4 relative z-20 text-center text-white">
        <div class="max-w-3xl mx-auto">
          <h1 class="text-4xl md:text-5xl font-bold mb-6">About Liberty Smile Center</h1>
          <p class="text-xl md:text-2xl text-gray-100 mb-4">Your trusted dental home across Southern California</p>
        </div>
      </div>
    </section>

    <section class="py-12 md:py-20 bg-white">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="prose lg:prose-xl mx-auto">
          <h2>Our Mission</h2>
          <p>At Liberty Smile Center, we believe that a healthy smile is the foundation of overall wellness. Our experienced team is dedicated to providing personalized, high-quality dental care in a warm and welcoming environment. With five convenient locations across Southern California, we make it easy for you and your family to receive the dental care you deserve.</p>

          <h2>Our Story</h2>
          <p>For over 10 years, Liberty Smile Center has been serving patients across South Gate, Van Nuys, Whittier, La Habra, and Downey. What started as a single office has grown into a network of five dental practices, each committed to the same standard of excellence. We have built our reputation on trust, transparency, and genuine care for our patients.</p>

          <h2>What Sets Us Apart</h2>
          <ul>
            <li><strong>Comprehensive Care:</strong> From preventive cleanings to advanced dental implants and orthodontics, we provide all the services you need under one roof.</li>
            <li><strong>Patient-First Approach:</strong> We prioritize transparency and patient well-being, ensuring a complete and detailed treatment plan with full disclosure before proceeding with any procedure.</li>
            <li><strong>Insurance & Financing:</strong> We accept Medi-Cal and most PPO insurance plans. No insurance? We offer 0% interest financing options.</li>
            <li><strong>Convenience:</strong> Walk-in appointments and same-day emergency services are available at all five locations.</li>
            <li><strong>Experienced Team:</strong> Our dentists and staff bring over a decade of experience in providing exceptional dental care.</li>
          </ul>

          <h2>Our Locations</h2>
          <p>We proudly serve patients across Southern California with five convenient offices:</p>
          <ul>
            {locations.map((loc) => (
              <li><strong>{loc.name}:</strong> {loc.address} · {loc.phoneDisplay}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <CallToAction />
  </main>

  <Footer />
</Layout>
