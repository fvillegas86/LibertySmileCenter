---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Contact Us | Liberty Smile Center">
  <div class="bg-brand-blue py-20 text-white text-center">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Contact Us</h1>
      <p class="text-blue-100 text-lg">We are here to help you smile.</p>
    </div>
  </div>

  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-16">
        <!-- Contact Info -->
        <div>
          <h2 class="text-3xl font-bold mb-8 text-slate-900">Get in Touch</h2>
          <div class="space-y-8">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-50 text-brand-blue rounded-lg flex items-center justify-center shrink-0">
                <Icon name="mdi:map-marker" class="size-6" />
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1">South Gate Office</h3>
                <p class="text-slate-600 mb-2">8330 Long Beach Blvd #107<br/>South Gate, CA 90280</p>
                <a href="tel:3235649400" class="text-brand-blue font-semibold hover:underline">(323) 564-9400</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-50 text-brand-blue rounded-lg flex items-center justify-center shrink-0">
                <Icon name="mdi:map-marker" class="size-6" />
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1">Van Nuys Office</h3>
                <p class="text-slate-600 mb-2">6736 Sepulveda Blvd<br/>Van Nuys, CA 91411</p>
                <a href="tel:8187868803" class="text-brand-blue font-semibold hover:underline">(818) 786-8803</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
               <div class="w-12 h-12 bg-blue-50 text-brand-blue rounded-lg flex items-center justify-center shrink-0">
                 <Icon name="mdi:email" class="size-6" />
               </div>
               <div>
                  <h3 class="font-bold text-lg mb-1">Email Us</h3>
                  <a href="mailto:info@libertysmilecenter.com" class="text-slate-600 hover:text-brand-blue transition-colors">info@libertysmilecenter.com</a>
               </div>
            </div>
          </div>
        </div>

        <!-- Form -->
        <div class="bg-white p-8 md:p-10 rounded-2xl shadow-lg border border-slate-100">
          <h3 class="text-2xl font-bold mb-6">Send us a Message</h3>
          <form class="space-y-6">
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-semibold text-slate-700 mb-2">Name</label>
                <input type="text" id="name" name="name" class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:border-brand-blue focus:ring-2 focus:ring-blue-100 outline-none transition-all" placeholder="Your Name" />
              </div>
              <div>
                <label for="phone" class="block text-sm font-semibold text-slate-700 mb-2">Phone</label>
                <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:border-brand-blue focus:ring-2 focus:ring-blue-100 outline-none transition-all" placeholder="(555) 000-0000" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-slate-700 mb-2">Email</label>
              <input type="email" id="email" name="email" class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:border-brand-blue focus:ring-2 focus:ring-blue-100 outline-none transition-all" placeholder="john@example.com" />
            </div>
            <div>
              <label for="message" class="block text-sm font-semibold text-slate-700 mb-2">Message</label>
              <textarea id="message" name="message" rows="4" class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:border-brand-blue focus:ring-2 focus:ring-blue-100 outline-none transition-all" placeholder="How can we help you?"></textarea>
            </div>
            <button type="submit" class="w-full py-4 bg-brand-gold text-slate-900 font-bold rounded-lg hover:bg-yellow-500 transition-colors shadow-md">
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
