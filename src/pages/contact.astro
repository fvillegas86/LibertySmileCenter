---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { locations } from '../data/locations';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Liberty Smile Center",
  "description": "Contact Liberty Smile Center. Reach out to schedule an appointment or ask questions at any of our 5 locations.",
  "url": "https://libertysmilecenter.com/contact"
};

const phoneMap: Record<string, string> = {};
locations.forEach((loc) => { phoneMap[loc.slug] = loc.phoneDisplay; });
---

<Layout title="Contact Us - Liberty Smile Center" description="Contact Liberty Smile Center. Reach out to schedule an appointment or ask questions at any of our 5 locations across Southern California." jsonLd={contactSchema}>
  <Header />

  <main id="main-content">
    <section class="bg-brand-blue py-12 md:py-16 text-white">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl font-bold mb-4">{t('contact.title')}</h1>
        <p class="text-xl text-white/90">{t('contact.subtitle')}</p>
      </div>
    </section>

    <section class="py-12 md:py-20 bg-white">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="grid lg:grid-cols-2 gap-12">

          <!-- Form -->
          <div class="bg-white p-8 rounded-2xl shadow-lg border border-slate-100">
            <h2 class="text-2xl font-bold text-slate-900 mb-6">{t('contact.send_message')}</h2>
            <form action="/api/contact" method="POST" class="space-y-5">
              <div>
                <label for="name" class="block text-sm font-semibold text-slate-700 mb-1">{t('contact.name')}</label>
                <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition" />
              </div>
              <div>
                <label for="phone" class="block text-sm font-semibold text-slate-700 mb-1">{t('contact.phone')}</label>
                <input type="tel" id="phone" name="phone" required class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition" />
              </div>
              <div>
                <label for="email" class="block text-sm font-semibold text-slate-700 mb-1">{t('contact.email')}</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition" />
              </div>
              <div>
                <label for="office" class="block text-sm font-semibold text-slate-700 mb-1">{t('contact.select_location')}</label>
                <select id="office" name="office" required class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition">
                  <option value="" disabled selected>{t('contact.select_location_placeholder')}</option>
                  {locations.map((loc) => (
                    <option value={loc.slug}>{loc.name} — {loc.phoneDisplay}</option>
                  ))}
                </select>
                <p id="phone-hint" class="mt-2 text-sm text-slate-600 hidden">
                  {t('contact.call_this_office')} <a id="phone-link" href="#" class="text-brand-blue font-semibold hover:underline"></a>
                </p>
              </div>
              <div>
                <label for="message" class="block text-sm font-semibold text-slate-700 mb-1">{t('contact.message')}</label>
                <textarea id="message" name="message" rows="4" class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-brand-blue focus:border-brand-blue outline-none transition"></textarea>
              </div>
              <button type="submit" class="w-full bg-brand-gold text-slate-900 font-bold py-4 rounded-lg hover:bg-yellow-500 transition-colors shadow-lg">
                {t('contact.send')}
              </button>
            </form>
          </div>

          <!-- Office Locations -->
          <div>
            <h2 class="text-2xl font-bold text-slate-900 mb-6">{t('contact.office_locations')}</h2>
            <div class="space-y-4">
              {locations.map((loc) => (
                <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
                  <h3 class="text-lg font-bold text-brand-blue mb-2">{loc.name}</h3>
                  <p class="text-slate-600 text-sm mb-2">{loc.address}</p>
                  <a href={`tel:${loc.phone}`} class="text-brand-blue font-semibold hover:underline text-sm">{loc.phoneDisplay}</a>
                  <div class="mt-3 h-32 bg-slate-200 rounded-lg overflow-hidden">
                    <iframe
                      src={loc.mapUrl}
                      title={`Map of Liberty Smile Center ${loc.name}`}
                      width="100%"
                      height="100%"
                      style="border:0;"
                      loading="lazy"
                      referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline define:vars={{ phoneMap }}>
  const officeSelect = document.getElementById('office');
  const phoneHint = document.getElementById('phone-hint');
  const phoneLink = document.getElementById('phone-link');

  if (officeSelect && phoneHint && phoneLink) {
    officeSelect.addEventListener('change', (e) => {
      const slug = e.target.value;
      const phone = phoneMap[slug];
      if (phone) {
        const cleanPhone = phone.replace(/\D/g, '');
        phoneLink.textContent = phone;
        phoneLink.href = `tel:${cleanPhone}`;
        phoneHint.classList.remove('hidden');
      } else {
        phoneHint.classList.add('hidden');
      }
    });
  }
</script>
