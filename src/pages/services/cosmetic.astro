---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Cosmetic Dentist | Liberty Smile Center" description="Transform your smile with veneers, whitening, and smile makeovers. Expert cosmetic dentistry in South Gate and Van Nuys.">
  <div class="bg-slate-50 py-20 text-center">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-slate-900">Cosmetic Dentistry</h1>
      <p class="text-slate-600 text-lg">Design the smile you've always wanted.</p>
    </div>
  </div>

  <section class="py-16">
    <div class="container mx-auto px-4">
       <div class="grid md:grid-cols-3 gap-8">
         <div class="p-8 border border-slate-100 rounded-2xl hover:shadow-lg transition-shadow">
           <Icon name="mdi:shimmer" class="size-10 text-brand-gold mb-4" />
           <h3 class="text-xl font-bold mb-3">Teeth Whitening</h3>
           <p class="text-slate-600">Brighten your smile by several shades with our professional whitening treatments.</p>
         </div>
         <div class="p-8 border border-slate-100 rounded-2xl hover:shadow-lg transition-shadow">
           <Icon name="mdi:shape" class="size-10 text-brand-gold mb-4" />
           <h3 class="text-xl font-bold mb-3">Veneers</h3>
           <p class="text-slate-600">Custom-made thin shells to cover imperfections and create a uniform, Hollywood smile.</p>
         </div>
         <div class="p-8 border border-slate-100 rounded-2xl hover:shadow-lg transition-shadow">
           <Icon name="mdi:emoticon-happy-outline" class="size-10 text-brand-gold mb-4" />
           <h3 class="text-xl font-bold mb-3">Smile Makeovers</h3>
           <p class="text-slate-600">A comprehensive plan enabling a complete transformation of your dental aesthetics.</p>
         </div>
       </div>

       <div class="mt-16 text-center">
         <h2 class="text-3xl font-bold mb-6">Ready for your transformation?</h2>
         <a href="/contact" class="px-8 py-4 bg-brand-blue text-white font-bold rounded-full shadow-lg hover:bg-blue-700 transition-colors">
           Get a Cosmetic Consultation
         </a>
       </div>
    </div>
  </section>
</Layout>
