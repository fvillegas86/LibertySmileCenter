---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Dental Implants South Gate & Van Nuys | Liberty Smile Center" description="Restore your smile with high-quality dental implants. 0% interest financing available.">
  <!-- Hero -->
  <div class="bg-slate-900 py-20 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20 bg-[url('https://libertysmilecenter.com/wp-content/uploads/2021/04/Dental-Implants-Liberty-Smile-Center.jpg')] bg-cover bg-center"></div>
    <div class="container mx-auto px-4 relative z-10 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Dental Implants</h1>
      <p class="text-xl text-blue-100 max-w-2xl mx-auto">
        The permanent solution for missing teeth. Restore your confidence and smile with our expert implant services.
      </p>
    </div>
  </div>

  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
        <div>
          <h2 class="text-3xl font-bold mb-6 text-slate-800">Why Choose Dental Implants?</h2>
          <ul class="space-y-4">
            {[
              "Natural look and feel",
              "Prevents bone loss",
              "Long-lasting solution",
              "No more slipping dentures"
            ].map(item => (
              <li class="flex items-center gap-3 text-slate-700 font-medium">
                <Icon name="mdi:check-circle" class="size-6 text-brand-gold" />
                {item}
              </li>
            ))}
          </ul>
          <div class="mt-8 p-6 bg-blue-50 rounded-xl border border-blue-100">
             <h3 class="font-bold text-brand-blue mb-2 flex items-center gap-2">
               <Icon name="mdi:finance" class="size-5" />
               Affordable Financing
             </h3>
             <p class="text-sm text-slate-600">We offer 0% interest payment plans to make your dream smile accessible.</p>
          </div>
        </div>
        <div class="bg-gray-100 rounded-2xl aspect-square flex items-center justify-center">
           <!-- Placeholder -->
           <Icon name="mdi:tooth" class="size-32 text-gray-300" />
        </div>
      </div>
      
      <div class="text-center">
        <a href="/contact" class="inline-block px-8 py-4 bg-brand-blue text-white font-bold rounded-full shadow-lg hover:bg-blue-700 transition-transform hover:-translate-y-1">
          Schedule Free Consultation
        </a>
      </div>
    </div>
  </section>
</Layout>
