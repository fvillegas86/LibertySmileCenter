---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="General Dentist South Gate | Liberty Smile Center" description="Comprehensive dental care including check-ups, cleanings, and oral surgery. We accept Medi-Cal and PPO insurance.">
  <div class="bg-brand-blue py-20 text-white text-center">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">General Dentistry</h1>
      <p class="text-blue-100 text-lg">Your foundation for a lifetime of healthy smiles.</p>
    </div>
  </div>

  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12">
        <div>
           <h2 class="text-3xl font-bold mb-6 text-slate-900">Comprehensive Dental Care</h2>
           <p class="mb-6 text-slate-600 leading-loose">
             Routine visits are essential for maintaining optimal oral health. We provide thorough examinations, professional cleanings, and preventative treatments to stop problems before they start.
           </p>
           <h3 class="text-xl font-bold mb-4 text-brand-blue">Our General Services</h3>
           <ul class="space-y-3">
             <li class="flex items-center gap-3"><Icon name="mdi:check" class="size-5 text-green-500" /> Routine Exams & X-Rays</li>
             <li class="flex items-center gap-3"><Icon name="mdi:check" class="size-5 text-green-500" /> Deep Cleanings</li>
             <li class="flex items-center gap-3"><Icon name="mdi:check" class="size-5 text-green-500" /> Fillings & Restorations</li>
             <li class="flex items-center gap-3"><Icon name="mdi:check" class="size-5 text-green-500" /> Root Canals</li>
             <li class="flex items-center gap-3"><Icon name="mdi:check" class="size-5 text-green-500" /> Extractions & Oral Surgery</li>
           </ul>
        </div>
        <div class="bg-slate-100 rounded-2xl flex items-center justify-center p-12">
           <div class="text-center">
             <Icon name="mdi:shield-star" class="size-24 text-brand-gold mb-4 mx-auto" />
             <h4 class="text-2xl font-bold mb-2">We Accept Medi-Cal</h4>
             <p class="text-slate-600">Quality care should be accessible to everyone.</p>
           </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
