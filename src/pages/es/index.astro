---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Footer from '../../components/Footer.astro';
import ServiceFeatures from '../../components/ServiceFeatures.astro';
import CallToAction from '../../components/CallToAction.astro';
import InsuranceBanner from '../../components/InsuranceBanner.astro';
import { useTranslations, getRelativeLocaleUrl } from '../../i18n/utils';
import { locations } from '../../data/locations';
import { servicesES } from '../../data/services';

const t = useTranslations('es');

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  "name": "Liberty Smile Center",
  "description": "Dentista familiar sirviendo a South Gate, Van Nuys, Whittier, La Habra y Downey, CA. Atención dental integral incluyendo odontología general, ortodoncia, implantes dentales y tratamientos cosméticos.",
  "url": "https://libertysmilecenter.com/es",
  "image": "https://libertysmilecenter.com/images/dental/main-office.webp",
  "priceRange": "$$",
  "areaServed": locations.map((loc) => loc.name),
  "department": locations.map((loc) => ({
    "@type": "Dentist",
    "name": `Liberty Smile Center - ${loc.name}`,
    "telephone": `+1${loc.phone}`,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": loc.streetAddress,
      "addressLocality": loc.city,
      "addressRegion": loc.state,
      "postalCode": loc.postalCode,
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": loc.geo.latitude,
      "longitude": loc.geo.longitude
    }
  }))
};

---

<Layout title="Liberty Smile Center - Dentista en South Gate, Van Nuys, Whittier, La Habra y Downey" lang="es" description="Dentista familiar en South Gate, Van Nuys, Whittier, La Habra y Downey, CA. Aceptamos Medi-Cal y seguros PPO. Citas el mismo día, se aceptan pacientes sin cita. Financiamiento 0% interés. ¡Llame hoy!" jsonLd={homeSchema}>
  <Header />

  <main id="main-content">
    <Hero />

    <!-- Intro Section -->
    <section class="py-12 md:py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <span class="text-brand-gold font-bold text-sm uppercase tracking-wider">{t('home.welcome')}</span>
            <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-2 mb-6">{t('home.exceptional_care')}</h2>
            <p class="text-slate-600 mb-6 leading-relaxed">{t('home.intro_p1')}</p>
            <p class="text-slate-600 mb-8 leading-relaxed">{t('home.intro_p2')}</p>
            <a href={getRelativeLocaleUrl('es', 'about')} class="text-brand-blue font-bold hover:underline">{t('location.learn_more')} →</a>
          </div>
          <div class="relative">
            
            <img
              src="/images/dental/main-office.webp"
              alt="Oficina Dental Liberty Smile Center"
              width="800"
              height="600"
              loading="eager"
              class="rounded-xl shadow-lg w-full"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Features / Why Choose Us -->
    <section class="patient-benefits py-16 md:py-24 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">{t('home.why_choose')}</h2>
          <p class="text-xl text-slate-600">{t('home.why_choose_subtitle')}</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="p-8 bg-white rounded-2xl hover:shadow-lg transition-shadow duration-300">
            <div class="w-14 h-14 bg-brand-blue/10 rounded-full flex items-center justify-center mb-6 text-brand-blue text-2xl">🏆</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">{t('location.experience')}</h3>
            <p class="text-slate-600 leading-relaxed">{t('location.experience_desc')}</p>
          </div>
          <div class="p-8 bg-white rounded-2xl hover:shadow-lg transition-shadow duration-300">
            <div class="w-14 h-14 bg-brand-blue/10 rounded-full flex items-center justify-center mb-6 text-brand-blue text-2xl">🦷</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">{t('location.full_service')}</h3>
            <p class="text-slate-600 leading-relaxed">{t('location.full_service_desc')}</p>
          </div>
          <div class="p-8 bg-white rounded-2xl hover:shadow-lg transition-shadow duration-300">
            <div class="w-14 h-14 bg-brand-blue/10 rounded-full flex items-center justify-center mb-6 text-brand-blue text-2xl">✨</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">{t('location.financing')}</h3>
            <p class="text-slate-600 leading-relaxed">{t('location.financing_desc')}</p>
          </div>
          <div class="p-8 bg-white rounded-2xl hover:shadow-lg transition-shadow duration-300">
            <div class="w-14 h-14 bg-brand-blue/10 rounded-full flex items-center justify-center mb-6 text-brand-blue text-2xl">🚶‍♂️</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">{t('location.walk_ins')}</h3>
            <p class="text-slate-600 leading-relaxed">{t('location.walk_ins_desc')}</p>
          </div>
          <div class="p-8 bg-white rounded-2xl hover:shadow-lg transition-shadow duration-300">
            <div class="w-14 h-14 bg-brand-blue/10 rounded-full flex items-center justify-center mb-6 text-brand-blue text-2xl">💳</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">{t('location.insurance')}</h3>
            <p class="text-slate-600 leading-relaxed">{t('location.insurance_desc')}</p>
          </div>
          <div class="p-8 bg-white rounded-2xl hover:shadow-lg transition-shadow duration-300">
            <div class="w-14 h-14 bg-brand-blue/10 rounded-full flex items-center justify-center mb-6 text-brand-blue text-2xl">❤️</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">{t('location.patient_focused')}</h3>
            <p class="text-slate-600 leading-relaxed">{t('location.patient_focused_desc')}</p>
          </div>
        </div>
      </div>
    </section>

    <ServiceFeatures />



    <!-- New Patients Section -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">{t('home.new_patients_title')}</h2>
          <p class="text-xl text-slate-600 mb-4">{t('home.new_patients_p1')}</p>
          <p class="text-lg text-slate-500 mb-8">{t('home.new_patients_p2')}</p>
          <div class="bg-blue-50 rounded-2xl p-6 inline-block">
            <p class="text-brand-blue font-bold text-lg mb-1">{t('home.no_insurance')}</p>
            <p class="text-slate-600">{t('home.no_insurance_desc')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Locations Section -->
    <section id="locations" class="location-directory py-12 md:py-20 bg-brand-blue text-white">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">{t('home.locations_title')}</h2>
          <p class="text-xl text-white/90">{t('home.locations_subtitle')}</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {locations.map((loc) => (
            <a href={getRelativeLocaleUrl('es', loc.slug)} class="bg-white/10 backdrop-blur-sm p-6 rounded-2xl hover:bg-white/20 transition-all duration-300 hover:scale-105 border border-white/20">
              <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mb-4 mx-auto text-3xl">
                🦷
              </div>
              <h3 class="text-xl font-bold text-center mb-2">{loc.name}</h3>
              <p class="text-white/80 text-center text-sm mb-2">{loc.streetAddress}<br/>{loc.city}, {loc.state} {loc.postalCode}</p>
              <p class="text-white/90 text-center text-sm font-semibold mb-4">{loc.phoneDisplay}</p>
              <span class="block text-center text-brand-blue font-bold text-sm bg-white px-4 py-2 rounded-full">{t('home.visit_location')} {loc.name} {t('home.location_link')}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <InsuranceBanner />

    <CallToAction />
  </main>

  <Footer />
</Layout>

<style>
.location-directory { background: #f1f6fb; color: #203251; padding-block: 58px; }
.location-directory :is(h2,h3) { color: #203251; }
.location-directory p { color: #526079; }
.location-directory .grid { max-width: none; gap: 0; }
.location-directory .grid > a { border-radius: 0; background: transparent; border: 0; border-left: 1px solid #d5dfec; padding: 20px; transform: none; }
.location-directory .grid > a:hover { background: #e3edf9; }
.location-directory .grid > a > div { display: none; }
.location-directory .grid > a > span { background: transparent; padding: 10px 0 0; font-size: 11px; }
@media(min-width: 1024px) { .location-directory .grid { grid-template-columns: repeat(5, 1fr); } }
</style>

<style>
.patient-benefits { background:#203251; color:white; }
.patient-benefits > div > div:first-child :is(h2,p) { color:white; }
.patient-benefits .grid > div { border-radius:24px; background:white; box-shadow:none; }
.patient-benefits .grid h3 { color:#203251; font-size:18px; }
.patient-benefits .grid p { color:#526079; font-size:14px; }
</style>
